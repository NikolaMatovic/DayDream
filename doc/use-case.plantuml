@startuml
left to right direction

actor Guest
actor User
actor Admin

rectangle "Daydream Management System" {

  usecase "UC01\nRegister with username,\nemail, password" as UC01
  usecase "UC02\nLogin and Logout" as UC02
  usecase "UC03\nBrowse Public Daydreams" as UC03

  usecase "UC04\nCreate Daydream" as UC04
  usecase "UC05\nUpdate Own Daydream" as UC05
  usecase "UC06\nDelete Own Daydream" as UC06
  usecase "UC07\nSet Public/Private Visibility" as UC07
  usecase "UC08\nView Personal Feed\n(My Daydreams Only)" as UC08
  usecase "UC09\nComment on Public Daydreams" as UC09

  usecase "UC10\nAdmin List and Delete\nUsers and Daydreams" as UC10
}

Guest --> UC01


User --> UC02
User --> UC03
User --> UC04
User --> UC05
User --> UC06
User --> UC07
User --> UC08
User --> UC09

Admin --> UC10

Admin --|> User

@enduml