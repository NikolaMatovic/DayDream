@startuml DayDream Use Cases
skinparam backgroundColor #FEFEFE
left to right direction


actor "User" as RegisteredUser

rectangle "DayDream Application" {
  usecase UC1 as "Sign Up"
  usecase UC2 as "Log In"
  usecase UC3 as "Create Daydream\n(Title, Description, Mood)"
  usecase UC4 as "Set Visibility\n(Public/Private)"
  usecase UC5 as "Add Tags to Daydream"
  usecase UC6 as "Browse Shared Daydreams"
  usecase UC7 as "Comment on Daydreams"
}

RegisteredUser --> UC1
RegisteredUser --> UC2
RegisteredUser --> UC3
RegisteredUser --> UC4
RegisteredUser --> UC5
RegisteredUser --> UC6
RegisteredUser --> UC7

UC3 ..> UC4 : <<include>>
UC3 ..> UC5 : <<include>>
UC7 ..> UC2 : <<include>>
UC3 ..> UC2 : <<include>>
UC6 ..> UC2 : <<include>>

@enduml