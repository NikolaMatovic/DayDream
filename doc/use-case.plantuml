@startuml
left to right direction

actor Visitor
actor User

rectangle "DayDream System" {
  usecase "Register Account" as UC1
  usecase "Log In" as UC2
  usecase "Log Out" as UC3
  usecase "Browse Public Daydreams" as UC4
  usecase "Create Daydream" as UC5
  usecase "Update Daydream" as UC6
  usecase "Delete Daydream" as UC7
  usecase "Set Daydream Visibility" as UC8
  usecase "View Personal Feed" as UC9
  usecase "Comment on Daydream" as UC10
}

Visitor --> UC1

User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10

@enduml