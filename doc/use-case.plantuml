@startuml
left to right direction

actor Visitor
actor User

rectangle "DayDream Application" {
  usecase "UC-10\nComment on Daydream" as UC10
  usecase "UC-9\nView Personal Feed" as UC9
  usecase "UC-8\nSet Daydream Visibility" as UC8
  usecase "UC-7\nDelete Daydream" as UC7
  usecase "UC-6\nUpdate Daydream" as UC6
  usecase "UC-5\nCreate Daydream" as UC5
  usecase "UC-4\nBrowse Public Daydreams" as UC4
  usecase "UC-3\nLog Out" as UC3
  usecase "UC-2\nLog In" as UC2
  usecase "UC-1\nRegister Account" as UC1
}

Visitor --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10

@enduml